.register-btn.data-v-6b0433d4 {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #d4b896 0%, #b89a7a 100%);
  color: white;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 25rpx;
