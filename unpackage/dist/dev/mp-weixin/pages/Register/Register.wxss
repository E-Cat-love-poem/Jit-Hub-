}
.register-btn.data-v-6b0433d4:hover:not(:disabled) {
  transform: translateY(-3rpx);
  box-shadow: 0 15rpx 40rpx rgba(184, 154, 122, 0.4);
}
.register-btn.data-v-6b0433d4:hover:not(:disabled)::before {
  left: 100%;
}
.register-btn.data-v-6b0433d4:active:not(:disabled) {
  transform: translateY(-1rpx);
  box-shadow: 0 8rpx 25rpx rgba(184, 154, 122, 0.3);
}
.register-btn.data-v-6b0433d4:disabled {
